programa {
  funcao inicio() {
      cadeia disciplina
    escreva ("Qual o nome da disciplina que está cursando? ")
    leia(disciplina)

      cadeia ano_curso
    escreva ("E qual o ano que você está cursando? ")
    leia(ano_curso)

    escreva ("O nome da dicisplina que está cursando é ", disciplina, "e o ano em que está cursando é ", ano_curso)
  }
}
